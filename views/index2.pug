extends layout2

block content
  a.btn.btn-success(href='/nuevo') + Nuevo Producto
  table.table.table-striped.mt-3
    thead
      tr
        th ID
        th Nombre
        th Precio
        th Acciones
    tbody
      each producto in productos
        tr
          td #{producto.id}
          td #{producto.nombre}
          td $#{producto.precio}
          td
            a.btn.btn-warning.btn-sm(href=`/editar/${producto.id}`) Editar
            a.btn.btn-danger.btn-sm.ms-2(href=`/eliminar/${producto.id}`) Eliminar

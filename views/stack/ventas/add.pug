extends ../layout

block content
  .d-flex.justify-content-center.align-items-center.my-5
    .card.text-center(style="width: 100%; max-width: 500px;")
      .card-header.bg-light.py-3
        h3.m-0.text-uppercase.fw-normal CREAR CLIENTE
      .card-body.p-4
        form(action="/add" method="POST")
          .input-group.mb-3
            span.input-group-text(style="width: 110px;") Nombre
            input.form-control(type="text" placeholder="Nombres" name="nombre")
          .input-group.mb-3
            span.input-group-text(style="width: 110px;") Apellidos
            input.form-control(type="text" placeholder="Apellidos" name="apellidos")
          .input-group.mb-3
            span.input-group-text(style="width: 110px;") Nro. DNI
            input.form-control(type="text" placeholder="Nro. DNI" name="dni")
          .input-group.mb-4
            span.input-group-text(style="width: 110px;") Nro. Teléfono
            input.form-control(type="text" placeholder="Nro. Célular" name="telefono")
          button.btn.btn-success.w-100.mb-2(type="submit") Guardar
          a.btn.btn-danger.w-100(href="/ventas/cliente") Cancelar
